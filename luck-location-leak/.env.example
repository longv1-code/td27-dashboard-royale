# Copy this file to .env (same folder) and fill in your own values. Never commit or share .env.
# Every key is optional: leave one blank and that feature simply turns off.

# Best Use of Gemini API -- key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
# optional: GEMINI_MODEL=gemini-2.5-flash
# optional: GEMINI_EMBED_MODEL=gemini-embedding-001   (768-d vectors for floor-note search)

# Best Use of MongoDB Atlas -- Connect > Drivers > Python connection string
# format: mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=

# Best Use of Tiger Data -- service connection string from the Tiger Cloud console
# format: postgres://tsdbadmin:PASSWORD@HOST.tsdb.cloud.timescale.com:PORT/tsdb?sslmode=require
TIMESCALE_URL=
